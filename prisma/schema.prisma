// MALULEKE-KS Platform — Prisma Schema
// Derives from PLATFORM-CONSTITUTION-v1.md §3
// Enforces BR-1.x through BR-8.x at the database-constraint level where possible;
// remaining business rules are enforced at the API layer (see openapi-contract.yaml).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Migrations run over a direct (non-pooled) connection — the pooler is for
  // the app's many short-lived queries, not schema changes (docs/DATABASE.md).
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector, pgcrypto, pg_trgm]
}

// ============================================================
// AUTH & ACCESS
// ============================================================

model AdminUser {
  id               String           @id @default(cuid())
  metricDecisions  MetricSnapshot[]
  email            String           @unique // always stored lowercase — normalized in app layer on write (BR-3.10)
  passwordHash     String
  role             String           @default("owner") // headroom field only — single-owner today, no RBAC engine (Constitution §1)
  twoFactorSecret  String? // encrypted at rest with TWO_FACTOR_ENCRYPTION_KEY, not plaintext
  twoFactorEnabled Boolean          @default(false)
  recoveryCodes    String[] // hashed, one-time use — exactly 10 generated at setup (BR-3.11)
  failedLoginCount Int              @default(0)
  lockedUntil      DateTime?        @db.Timestamptz(3) // BR-3.2
  lastLoginAt      DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)
  activityLogs     ActivityLog[]
  loginChallenges  LoginChallenge[]
  // No separate @@index([email]): the @unique above already is one.
}

model LoginChallenge {
  // Bridges step-1 (credentials) and step-2 (TOTP) of admin login.
  // Short-lived and single-use by design (BR-3.5, BR-3.6) — this table is
  // pruned continuously and is never part of the 24-month retention policy.
  id          String    @id @default(cuid())
  tokenHash   String    @unique // the challengeToken is never stored raw
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  attempts    Int       @default(0) // BR-3.6 — invalidated at 5
  consumedAt  DateTime? @db.Timestamptz(3) // set on first verify attempt, success or failure (BR-3.5)
  expiresAt   DateTime  @db.Timestamptz(3) // issuedAt + 5 minutes (BR-3.5)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([expiresAt])
}

model RateLimitEntry {
  // Generic short-window rate-limit ledger (BR-2.4 inquiries, BR-3.2/3.6 auth).
  // Deliberately its own table with its own short retention, separate from
  // Inquiry/Event's 24-month policy — an IP address here is kept only as
  // long as the relevant window requires (BR-2.4).
  id        String   @id @default(cuid())
  bucketKey String // e.g. "inquiry:ip:203.0.113.4" or "login2fa:challenge:<id>"
  windowEnd DateTime @db.Timestamptz(3) // entry is inert/prunable once now() > windowEnd
  count     Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@unique([bucketKey, windowEnd])
  @@index([windowEnd])
}

// Who performed an audited action. A fixed control dimension (EXT-1
// exception): the kinds of actor don't grow with content.
enum ActorType {
  ADMIN // an authenticated admin (adminUserId set)
  ANONYMOUS // an unauthenticated attempt, e.g. a failed login for an unknown email
  SYSTEM // a scheduled job or operator script
}

// Append-only (F1.3): the database refuses UPDATE and DELETE on this table
// (trigger ActivityLog_append_only), so the trail can't be edited after the
// fact. Request context is stored only as keyed hashes (lib/security/
// keyed-hash.ts) — comparable, never readable.
model ActivityLog {
  id            String     @id @default(cuid())
  actorType     ActorType  @default(ADMIN)
  adminUserId   String? // null for ANONYMOUS/SYSTEM actors — so every login attempt can be logged (BR-3.4)
  adminUser     AdminUser? @relation(fields: [adminUserId], references: [id])
  action        String // "system.update" | "auth.login" | "auth.login_failed" | ... (BR-3.4)
  entityType    String?
  entityId      String?
  before        Json?
  after         Json?
  subjectHash   String? // keyed hash of what an anonymous actor tried (e.g. an unknown login email)
  ipHash        String? // keyed hash of the client IP
  userAgentHash String? // keyed hash of the user agent
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@index([adminUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ============================================================
// ORGANIZATIONS & SYSTEMS
// ============================================================

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  role         String? // "Founder" | "Co-founder"
  isClient     Boolean  @default(false) // drives BR-1.2 default at System creation time only — never retroactive
  // Optional override for GitHub org/user login names that don't slugify to
  // this Organization's slug (e.g. GitHub login "MALULEKE-KS" -> this row's
  // slug "personal"). github-sync.ts checks this before falling back to
  // slugify(githubLogin) == slug.
  githubLogins String[] @default([])
  systems      System[]
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// Which pipeline count a Status belongs to. A fixed control dimension (EXT-1
// exception, like ContentStatus): the statuses themselves stay an open lookup.
enum PipelineStage {
  SHIPPED
  BUILDING
  QUEUED
}

model Status {
  id          String               @id @default(cuid())
  key         String               @unique // "finished" | "in_progress" | "planned" — extendable per BR-8.1
  label       String
  colorToken  String               @default("signal-planned") // e.g. "signal-finished" — a CSS custom-property/Tailwind token name.
  // New Status values carry their own color as data (this field), so
  // a new admin-added status never needs a component code change (EXT-1).
  active      Boolean              @default(true) // BR-8.2 soft-deprecation
  systems     System[]
  changesFrom SystemStatusChange[] @relation("fromStatus")
  changesTo   SystemStatusChange[] @relation("toStatus")
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @default(now()) @updatedAt @db.Timestamptz(3)
  // Which homepage count this status belongs to (#52). Any status the admin
  // creates — "Live", "Refinished" — joins shipped/building/queued by
  // choosing a stage, with no code change (EXT-1).
  stage       PipelineStage        @default(QUEUED)
}

model Domain {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  systems   System[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

enum ClientVisibility {
  PUBLIC
  REQUIRES_APPROVAL
  NDA_RESTRICTED
  ANONYMIZED_ONLY
  // Deliberately an enum, not a lookup table — a fixed compliance state
  // machine, not a growing content dimension (Constitution §1, EXT-1 exception).
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  // Same exception as ClientVisibility — see BR-1.5.
}

model System {
  id                     String           @id @default(cuid())
  name                   String
  slug                   String           @unique
  // Stable GitHub identity, independent of name/slug — used to match an
  // existing System across a repo rename instead of matching by slugify(name),
  // which would otherwise create a duplicate row on every rename.
  githubRepoId           Int?             @unique
  organizationId         String
  organization           Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  statusId               String
  status                 Status           @relation(fields: [statusId], references: [id], onDelete: Restrict)
  domainId               String?
  domain                 Domain?          @relation(fields: [domainId], references: [id], onDelete: SetNull)
  description            String
  repoUrl                String?
  liveUrl                String?
  screenshotUrl          String? // homepage preview image for the public case study/card (Constitution §8 systems catalog)
  techStack              String[]
  isFlagship             Boolean          @default(false)
  sortOrder              Int              @default(0)
  clientVisibility       ClientVisibility @default(PUBLIC) // BR-1.2 default is applied in app logic on create
  clientApproved         Boolean          @default(false) // authorizes publishing (BR-1.1) — NOT the same authorization as revealing the real org name
  // Separate from clientApproved on purpose (BR-1.4): a client can approve
  // publishing an ANONYMIZED_ONLY case study without approving disclosure of
  // their real name in it. Reusing clientApproved for both would make name
  // masking unreachable for any published system, since BR-1.1 already
  // requires clientApproved=true to publish anything non-PUBLIC.
  nameDisclosureApproved Boolean          @default(false)
  contentStatus          ContentStatus    @default(DRAFT) // BR-1.6: sync-created rows always start here
  needsCuration          Boolean          @default(false) // set true by GitHub sync; cleared once an admin opens+saves the record (BR-1.8)
  // No delete endpoint exists for System anywhere in the contract — retirement
  // is always contentStatus = ARCHIVED (BR-1.9). Rows are never hard-deleted.
  caseStudyBody          String? // MDX
  impacts                Impact[]
  testimonials           Testimonial[]
  skills                 SkillOnSystem[]
  createdAt              DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime         @updatedAt @db.Timestamptz(3)
  // Hand-picked for the homepage by the admin (#52), shown in homeOrder.
  // Only published systems are ever shown, whatever this says.
  featuredOnHome         Boolean          @default(false)
  homeOrder              Int              @default(0)
  // Listed under Projects on the CV (#74) — published systems only, whatever this says.
  onCv                   Boolean          @default(true)
  cvOrder                Int              @default(0)

  // --- Repo ownership (#69, BR-1.11) ---
  // How this system's repo relates to the owner: owned, collaborated on, ...
  // A lookup (EXT-1). When the relationship requires it, the repo owner's
  // permission gates publishing, enforced by a database trigger.
  repoRelationshipId  String?
  repoRelationship    RepoRelationship? @relation(fields: [repoRelationshipId], references: [id], onDelete: Restrict)
  ownerPermission     OwnerPermission   @default(NOT_REQUIRED)
  ownerPermissionFrom String? // who granted or declined it: the repo owner's name or GitHub login
  ownerPermissionAt   DateTime?         @db.Timestamptz(3) // set by the database whenever ownerPermission changes
  ownerPermissionNote String?

  // --- GitHub metadata (#70): sourced facts, refreshed by the sync (F4) ---
  githubFullName   String?   @unique // "owner/repo"
  githubOwnerLogin String?
  repoPrivate      Boolean   @default(false) // BR-1.7: shown as private publicly, never linked
  githubPushedAt   DateTime? @db.Timestamptz(3)
  githubLanguages  Json? // { "TypeScript": 120345, ... } bytes per language
  githubTopics     String[]  @default([])
  githubStars      Int?
  githubSyncedAt   DateTime? @db.Timestamptz(3)

  statusChanges   SystemStatusChange[]
  activityWeeks   SystemActivityWeek[]
  timelineEntries Timeline[]
  achievements    Achievement[]

  @@index([contentStatus])
  @@index([organizationId])
  @@index([domainId])
  @@index([statusId])
  @@index([featuredOnHome, homeOrder])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "System_name_trgm_idx")
}

model Impact {
  id        String   @id @default(cuid())
  systemId  String
  system    System   @relation(fields: [systemId], references: [id], onDelete: Cascade)
  label     String // "Audit findings closed"
  value     String // "58"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([systemId, sortOrder])
}

model Testimonial {
  id            String   @id @default(cuid())
  systemId      String?
  system        System?  @relation(fields: [systemId], references: [id], onDelete: SetNull) // a testimonial outlives the (archived, never deleted) System it praised
  authorName    String
  authorRole    String?
  organization  String?
  quote         String
  hasPermission Boolean  @default(false) // BR-6.1 — absolute gate, checked at read time
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([systemId])
}

// How a system's repo relates to the owner (#69). A lookup, not an enum
// (EXT-1): "owner", "collaborator", and whatever comes next. The flag is data
// too: any relationship can require the repo owner's permission to publish.
model RepoRelationship {
  id                      String   @id @default(cuid())
  key                     String   @unique
  label                   String
  requiresOwnerPermission Boolean  @default(false)
  active                  Boolean  @default(true) // BR-8.2 soft-deprecation
  systems                 System[]
  createdAt               DateTime @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// The repo owner's answer for a collaborated system (BR-1.11). A fixed control
// state, like ClientVisibility, not a growing content dimension (EXT-1
// exception). The database keeps it consistent with the relationship.
enum OwnerPermission {
  NOT_REQUIRED
  NOT_REQUESTED
  REQUESTED
  GRANTED
  DECLINED
}

// Every status a system has been in, written by a database trigger (never by
// application code) and append-only. The stage is snapshotted at the time of
// the change, so shipped dates survive later reclassification of a status.
// Rows marked backfilled record the state that existed when history began;
// they are not claims about when it happened.
model SystemStatusChange {
  id           String         @id @default(cuid())
  systemId     String
  system       System         @relation(fields: [systemId], references: [id], onDelete: Restrict)
  fromStatusId String?
  fromStatus   Status?        @relation("fromStatus", fields: [fromStatusId], references: [id], onDelete: Restrict)
  toStatusId   String
  toStatus     Status         @relation("toStatus", fields: [toStatusId], references: [id], onDelete: Restrict)
  fromStage    PipelineStage?
  toStage      PipelineStage
  backfilled   Boolean        @default(false)
  changedAt    DateTime       @default(now()) @db.Timestamptz(3)

  @@index([systemId, changedAt])
}

// Commits per ISO week (weekStart is a Monday), per system: "Now building"
// and pace (#70). Filled by the GitHub sync (F4).
model SystemActivityWeek {
  systemId  String
  system    System   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  weekStart DateTime @db.Date
  commits   Int
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@id([systemId, weekStart])
}

// ============================================================
// CAREER & ACADEMIC RECORD
// ============================================================

model MilestoneType {
  id              String     @id @default(cuid())
  key             String     @unique // "education" | "job" | "launch" | "achievement" | "personal"
  label           String
  active          Boolean    @default(true)
  // The one milestone type a system's first ship is auto-drafted as (#70).
  // Data, not a hardcoded key; a partial unique index allows at most one.
  autoDraftOnShip Boolean    @default(false)
  timelineEntries Timeline[]
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @default(now()) @updatedAt @db.Timestamptz(3)
}

model Timeline {
  id              String        @id @default(cuid())
  milestoneTypeId String
  milestoneType   MilestoneType @relation(fields: [milestoneTypeId], references: [id])
  title           String
  description     String?
  date            DateTime      @db.Timestamptz(3)
  media           String?
  tags            String[]
  // Only PUBLISHED entries are public. Auto-drafted entries start as DRAFT
  // and wait for the admin's approval (#70).
  contentStatus   ContentStatus @default(PUBLISHED)
  systemId        String?
  system          System?       @relation(fields: [systemId], references: [id], onDelete: Restrict)
  autoDrafted     Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([date])
  @@index([milestoneTypeId])
  @@index([contentStatus, date])
  @@index([systemId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "Timeline_title_trgm_idx")
}

// The owner's public profile (#70): one row, enforced by a CHECK. Everything
// here is admin-editable data, never copy in code. Fields the owner hasn't
// provided stay empty; nothing is invented.
model Profile {
  id                Int           @id @default(1)
  displayName       String
  initials          String?
  // The CV/profile headline, e.g. "Software & AI Engineer" (#74). role keeps
  // the organizational title.
  headline          String?
  role              String
  location          String?
  email             String
  // Shown on the CV only when the owner sets it — never derived from links.
  phone             String?
  // The CV's professional summary (2–4 lines), written or approved by the owner.
  summary           String?
  bio               String?
  availability      String?
  buildingSinceYear Int?
  links             ProfileLink[]
  createdAt         DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @default(now()) @updatedAt @db.Timestamptz(3)
}

// Social and contact links: a growing set, so rows, not columns (EXT-1).
// kind names the brand icon ("github", "linkedin", ...).
model ProfileLink {
  id        String   @id @default(cuid())
  profileId Int      @default(1)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  kind      String   @unique
  label     String
  url       String
  sortOrder Int      @default(0)
  onCv      Boolean  @default(true) // include on the generated CV (#74)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([profileId, sortOrder])
}

// Certifications, awards, recognitions (#70). They start as drafts and stay
// empty until the owner provides real ones.
model Achievement {
  id            String        @id @default(cuid())
  title         String
  issuer        String?
  achievedOn    DateTime      @db.Date
  description   String?
  url           String?
  systemId      String?
  system        System?       @relation(fields: [systemId], references: [id], onDelete: Restrict)
  contentStatus ContentStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([contentStatus, achievedOn])
  @@index([systemId])
}

model Experience {
  id            String              @id @default(cuid())
  title         String
  organization  String
  location      String?
  startDate     DateTime            @db.Timestamptz(3)
  endDate       DateTime?           @db.Timestamptz(3)
  description   String
  // Achievement bullets for the CV, in order (#74) — what was done and its
  // impact. Tailoring puts the most relevant first.
  highlights    String[]            @default([])
  // Only PUBLISHED roles appear on /cv and in the generated CV (#74).
  contentStatus ContentStatus       @default(PUBLISHED)
  skills        SkillOnExperience[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @default(now()) @updatedAt @db.Timestamptz(3)
}

model Education {
  id                 String             @id @default(cuid())
  institution        String
  qualification      String
  startDate          DateTime           @db.Timestamptz(3)
  endDate            DateTime?          @db.Timestamptz(3) // null = still studying
  honors             String?
  // #70 — what was studied, and proof of it. All optional: nothing is
  // required that the owner hasn't provided.
  fieldOfStudy       String?
  description        String?
  certificateUrl     String? // https only (CHECK)
  // For a degree in progress (endDate null): when it's expected to finish (#74).
  expectedGraduation DateTime?          @db.Date
  // Relevant modules — standard on a student's CV (#74).
  coursework         String[]           @default([])
  // Only PUBLISHED entries appear on /cv and in the generated CV; the admin
  // decides what's shown.
  contentStatus      ContentStatus      @default(PUBLISHED)
  skills             SkillOnEducation[]
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([contentStatus, startDate])
}

model SkillCategory {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  active    Boolean  @default(true)
  skills    Skill[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Skill {
  id              String              @id @default(cuid())
  name            String              @unique
  categoryId      String
  category        SkillCategory       @relation(fields: [categoryId], references: [id])
  yearsExperience Float?
  systems         SkillOnSystem[]
  experiences     SkillOnExperience[]
  education       SkillOnEducation[]
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "Skill_name_trgm_idx")
}

model SkillOnSystem {
  skillId  String
  systemId String
  skill    Skill  @relation(fields: [skillId], references: [id], onDelete: Restrict) // an in-use Skill can't be deleted, same discipline as BR-8.2
  system   System @relation(fields: [systemId], references: [id], onDelete: Cascade)

  @@id([skillId, systemId])
  @@index([systemId]) // the composite PK leads with skillId; this serves "skills of a system"
}

model SkillOnExperience {
  skillId      String
  experienceId String
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@id([skillId, experienceId])
  @@index([experienceId])
}

// Skills a qualification taught (#70) — feeds skill evidence alongside roles
// and systems.
model SkillOnEducation {
  skillId     String
  educationId String
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)
  education   Education @relation(fields: [educationId], references: [id], onDelete: Cascade)

  @@id([skillId, educationId])
  @@index([educationId])
}

model DocumentGen {
  id                  String   @id @default(cuid())
  type                String // "cv" | "resume-tailored"
  targetRole          String?
  generatedAt         DateTime @default(now()) @db.Timestamptz(3) // BR-7.1 — always reflects live data at this timestamp
  // Self-hosted per Constitution §9 — the generated PDF's actual bytes, not
  // just a reference to external object storage. Small documents (a CV),
  // low volume (one admin, generated on visitor demand): Postgres is the
  // right store here, not a reason to add a new external dependency.
  fileData            Bytes
  fileUrl             String // resolves to the /api/v1/cv/documents/{id} download route
  supersededByFileUrl String? // BR-7.2 — prior versions kept, not deleted
  // "pdf" | "docx" — the same CV in two formats (#74). Supersession is per format.
  format              String   @default("pdf")
  // The completeness report when this document was generated (#74).
  completeness        Json?
}

// ============================================================
// VISITOR INTAKE
// ============================================================

model InquiryType {
  id        String    @id @default(cuid())
  key       String    @unique // hire | partnership | service | contribution | recruitment | collaboration
  label     String
  active    Boolean   @default(true)
  inquiries Inquiry[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)
}

enum InquiryStatus {
  NEW
  REVIEWED
  RESPONDED
  CLOSED
  // Fixed workflow state machine — sequential transitions enforced in app logic (BR-2.1)
}

model Inquiry {
  id             String        @id @default(cuid())
  inquiryTypeId  String
  inquiryType    InquiryType   @relation(fields: [inquiryTypeId], references: [id])
  name           String
  email          String
  message        String // BR-2.3: 20-5000 chars, enforced in lib/schemas.ts
  source         String? // captured server-side only; "direct" when no Referer (BR-2.5)
  status         InquiryStatus @default(NEW)
  idempotencyKey String?       @unique // BR-2.6 — dedupes a resubmit within the client-held window
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([status, createdAt])
  @@index([inquiryTypeId])
}

// ============================================================
// VISITOR SEGMENTATION, AI, ANALYTICS
// ============================================================

model VisitorLens {
  id              String   @id @default(cuid())
  key             String   @unique // "recruiter" | "client-fintech" | "academic" | ...
  label           String
  priorityContent Json
  aiFramingPrompt String
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Event {
  id         String   @id @default(cuid())
  eventType  String // "page_view" | "system_viewed" | "concierge_message" | "resume_downloaded"
  entityType String?
  entityId   String?
  sessionId  String
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([eventType, createdAt])
  @@index([sessionId])
}

model ContentChunk {
  id         String                      @id @default(cuid())
  entityType String // "system" | "timeline" | "skill" | "document"
  entityId   String
  content    String
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime                    @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([entityType, entityId])
}

// Admin-editable tunables (#67) — rate limits, SLAs, retention. The typed
// registry in lib/settings/registry.ts owns each key's schema, bounds and
// default; a row here only overrides the default. Values a business rule
// fixes (BR-2.3, BR-3.2, BR-3.5) are deliberately NOT settings.
model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Flag {
  id        String   @id @default(cuid())
  key       String   @unique
  enabled   Boolean  @default(false) // BR-4.4 — new tools/lenses ship disabled by default
  notes     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// ============================================================
// SCHEDULED JOBS
// ============================================================

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// One row per run of a scheduled job (GitHub sync, retention, ...) (#70).
// A partial unique index allows only one RUNNING row per job: the database
// is the lock, so overlapping runs can't happen. Finished runs are immutable.
model JobRun {
  id         String       @id @default(cuid())
  job        String
  status     JobRunStatus @default(RUNNING)
  startedAt  DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?    @db.Timestamptz(3)
  summary    Json?
  error      String?

  @@index([job, startedAt])
}

// ============================================================
// CURATED NUMBERS (approved feature 6, BR-5.3)
// ============================================================

enum MetricSource {
  COMPUTED // proposed by the platform from public data
  MANUAL // entered by the admin
}

enum MetricSnapshotStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

// Which numbers the platform can show publicly (F1.7). Rows, not code: labels
// and order are the admin's. A key with a registered computation
// (lib/metrics/registry.ts) is proposed automatically; any other is manual.
model Metric {
  key         String           @id
  label       String
  description String?
  unit        String?
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  snapshots   MetricSnapshot[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
}

// Every value a metric has had, proposed then decided (BR-5.3). Only an
// APPROVED snapshot is ever public. The database fixes a snapshot's value once
// proposed, allows only forward transitions, keeps one APPROVED and one
// PROPOSED per metric, and never deletes history.
model MetricSnapshot {
  id          String               @id @default(cuid())
  metricKey   String
  metric      Metric               @relation(fields: [metricKey], references: [key], onDelete: Restrict)
  value       Float
  source      MetricSource
  status      MetricSnapshotStatus @default(PROPOSED)
  proposedAt  DateTime             @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?            @db.Timestamptz(3)
  decidedById String?
  decidedBy   AdminUser?           @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([metricKey, status])
}

// ============================================================
// PUBLIC VIEWS (F1.7) — the only shape public pages read
// ============================================================
// Created in SQL (migration 20260919070000_public_views_search_metrics).
// Every masking and visibility rule is applied inside the view, so a public
// query can't forget one: BR-1.1 published-only, BR-1.3 NDA links, BR-1.4
// anonymized names (including the organization list), BR-1.7 private repos,
// BR-1.12 journey entries, BR-6.1/6.2 testimonials, BR-5.3 approved numbers.
// Read-only; F1.8 limits the public site's database role to these views.

view PublicSystem {
  id               String    @unique
  name             String
  slug             String    @unique
  organization     String // masked for ANONYMIZED_ONLY without disclosure (BR-1.4)
  organizationSlug String? // null when the name is masked, so filters can't correlate
  statusKey        String
  status           String
  statusColorToken String
  stage            String // shipped | building | queued
  domainKey        String?
  domain           String?
  description      String
  repoUrl          String? // null for NDA_RESTRICTED (BR-1.3) or a private repo (BR-1.7)
  liveUrl          String?
  screenshotUrl    String?
  techStack        String[]
  isFlagship       Boolean
  repoPrivate      Boolean
  sortOrder        Int
  featuredOnHome   Boolean
  homeOrder        Int
  caseStudyBody    String
  githubPushedAt   DateTime?
  updatedAt        DateTime
  onCv             Boolean
  cvOrder          Int
}

view PublicImpact {
  id        String @unique
  systemId  String
  label     String
  value     String
  sortOrder Int
}

view PublicTestimonial {
  id           String   @unique
  systemId     String?
  authorName   String
  authorRole   String?
  organization String? // masked like the system's organization (BR-1.4)
  quote        String
  createdAt    DateTime
}

view PublicTimeline {
  id                 String   @unique
  milestoneType      String
  milestoneTypeLabel String
  title              String
  description        String?
  date               DateTime
  tags               String[]
  autoDrafted        Boolean
  systemId           String?
  systemSlug         String?
}

view PublicEducation {
  id                 String    @unique
  institution        String
  qualification      String
  fieldOfStudy       String?
  startDate          DateTime
  endDate            DateTime?
  honors             String?
  description        String?
  certificateUrl     String?
  skills             String[]
  expectedGraduation DateTime?
  coursework         String[]
}

view PublicOrganization {
  id   String @unique
  name String
  slug String @unique
}

// One row: the homepage ledger's live facts about the owner's own catalog.
// Aggregates only — no unpublished system is ever named.
view PublicLedger {
  id                   Int       @unique
  systemsShipped       Int
  systemsBuilding      Int
  systemsQueued        Int
  organizationsFounded Int
  firstExperienceAt    DateTime?
}

view PublicProfile {
  id                Int     @unique
  displayName       String
  initials          String?
  role              String
  location          String?
  email             String
  bio               String?
  availability      String?
  buildingSinceYear Int?
  headline          String?
  phone             String?
  summary           String?
}

view PublicProfileLink {
  id        String  @unique
  kind      String
  label     String
  url       String
  sortOrder Int
  onCv      Boolean
}

// Roles the admin chose to show (#74), with their skills.
view PublicExperience {
  id           String    @unique
  title        String
  organization String
  location     String?
  startDate    DateTime
  endDate      DateTime?
  description  String
  highlights   String[]
  skills       String[]
}

// Certifications and awards the admin published (#74).
view PublicAchievement {
  id          String   @unique
  title       String
  issuer      String?
  achievedOn  DateTime
  description String?
  url         String?
  systemSlug  String?
  sortOrder   Int
}

// Only admin-approved numbers (BR-5.3).
view PublicMetric {
  key         String   @unique
  label       String
  description String?
  unit        String?
  value       Float
  approvedAt  DateTime
  sortOrder   Int
}
