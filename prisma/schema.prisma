  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

// ============================================================
// SCHEDULED JOBS
// ============================================================

enum JobRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// One row per run of a scheduled job (GitHub sync, retention, ...) (#70).
// A partial unique index allows only one RUNNING row per job: the database
// is the lock, so overlapping runs can't happen. Finished runs are immutable.
model JobRun {
  id          String       @id @default(cuid())
  job         String
  status      JobRunStatus @default(RUNNING)
  startedAt   DateTime     @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime?    @db.Timestamptz(3)
  summary     Json?
  error       String?
  // #94 — what started the run: "schedule" | "admin" | "script" ("unknown" = before this was recorded).
  trigger     String       @default("script")
  adminUserId String?
  adminUser   AdminUser?   @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([job, startedAt])
  @@index([adminUserId])
}

// ============================================================
// CURATED NUMBERS (approved feature 6, BR-5.3)
// ============================================================

enum MetricSource {
  COMPUTED // proposed by the platform from public data
  MANUAL // entered by the admin
}

enum MetricSnapshotStatus {
  PROPOSED
  APPROVED
  REJECTED
  SUPERSEDED
}

// Which numbers the platform can show publicly (F1.7). Rows, not code: labels
// and order are the admin's. A key with a registered computation
// (lib/metrics/registry.ts) is proposed automatically; any other is manual.
model Metric {
  key         String           @id
  label       String
  description String?
  unit        String?
  sortOrder   Int              @default(0)
  active      Boolean          @default(true)
  snapshots   MetricSnapshot[]
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @default(now()) @updatedAt @db.Timestamptz(3)
}

// Every value a metric has had, proposed then decided (BR-5.3). Only an
// APPROVED snapshot is ever public. The database fixes a snapshot's value once
// proposed, allows only forward transitions, keeps one APPROVED and one
// PROPOSED per metric, and never deletes history.
model MetricSnapshot {
  id          String               @id @default(cuid())
  metricKey   String
  metric      Metric               @relation(fields: [metricKey], references: [key], onDelete: Restrict)
  value       Float
  source      MetricSource
  status      MetricSnapshotStatus @default(PROPOSED)
  proposedAt  DateTime             @default(now()) @db.Timestamptz(3)
  decidedAt   DateTime?            @db.Timestamptz(3)
  decidedById String?
  decidedBy   AdminUser?           @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([metricKey, status])
}

// ============================================================
// PUBLIC VIEWS (F1.7) — the only shape public pages read

// #88 / BR-1.15 — every version of a system's case study and description,
// written by a database trigger on each change and attributed like the audit
// trail. Append-only (trigger + the runtime role's grants). Restoring writes an
// old text back, which becomes a new version.
model SystemContentRevision {
  id          String     @id @default(cuid())
  systemId    String
  system      System     @relation(fields: [systemId], references: [id], onDelete: Restrict)
  field       String // "caseStudyBody" | "description"
  body        String? // null = the field was cleared
  actorType   ActorType
  adminUserId String?
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Restrict)
  backfilled  Boolean    @default(false) // the text when history began — not a dated edit
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)

  @@index([systemId, field, createdAt(sort: Desc)], map: "SystemContentRevision_system_field_idx")
  @@index([adminUserId])
}

// #87 / BR-1.14 — every slug a system gave up, written by a database trigger on
// rename (admin or GitHub sync). An old slug redirects permanently to the
// system's current one and stays reserved for it.
model SystemSlugHistory {
  slug      String   @id
  systemId  String
  system    System   @relation(fields: [systemId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([systemId])
}

// #92 — a CV file the owner uploads, offered to visitors beside the generated
// CV (BR-7.1). Versions are superseded, never deleted or altered (BR-7.2,
// enforced by a trigger and the runtime role's grants). One current per format.
model CvUpload {
  id           String    @id @default(cuid())
  format       String // "pdf" | "docx" — checked by content on upload (BR-7.6)
  fileName     String // as uploaded; shown in the admin only
  byteSize     Int
  sha256       String
  fileData     Bytes
  uploadedAt   DateTime  @default(now()) @db.Timestamptz(3)
  supersededAt DateTime? @db.Timestamptz(3) // null = current for its format
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  @@index([format, uploadedAt(sort: Desc)])
}

// #92 / BR-7.5 — which CV options visitors see and in what order; labels are
// data. One row (id 1). The database refuses hiding both, listing a hidden
// option first, or hiding the generated CV before any upload exists.
model CvOptions {
  id             Int      @id @default(1)
  showGenerated  Boolean  @default(true)
  showUploaded   Boolean  @default(true)
  firstOption    String   @default("generated") // "generated" | "uploaded"
  generatedLabel String   @default("Generated CV")
  generatedNote  String   @default("Built from this site's live data at the moment you download it.")
  uploadedLabel  String   @default("Uploaded CV")
  uploadedNote   String   @default("A CV file uploaded as-is, shown with its upload date.")
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

