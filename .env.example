# .env.example
# Copy to .env.local for development. Never commit the real .env file.
# Every secret below is referenced by name only in schema.prisma / lib / api routes —
# no secret value is ever hardcoded in the codebase (EXT-1: config, not code).

# --- Database ---
# Pooled connection — used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/malulekeks?schema=public"
# Direct (non-pooled) connection — used only for migrations (schema.prisma directUrl).
# Locally both can be the same URL.
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/malulekeks?schema=public"
# Apply migrations during the Vercel build for this environment (scripts/vercel-build.mjs).
# Set to "true" per environment in Vercel — see docs/DEPLOYMENT.md. Leave unset locally.
DB_MIGRATE_ON_BUILD=""

# --- Auth (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # generate with: openssl rand -base64 32

# --- Admin 2FA (BR-3.1) ---
TWO_FACTOR_ENCRYPTION_KEY="" # 32-byte key, used to encrypt AdminUser.twoFactorSecret at rest

# --- AI layer (Constitution §6) ---
# Kept inside the Next.js app per the deliberate infra call — no separate
# FastAPI/LangChain service. Model provider is an adapter (EXT-1); swapping
# providers later means changing this key and the adapter, not the orchestration core.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_DAILY_COST_CAP_USD="10" # AI abuse protection — pre-launch requirement, Constitution §9
AI_RATE_LIMIT_PER_SESSION="20"

# --- Analytics (Constitution §8) ---
VERCEL_ANALYTICS_ID=""
ANALYTICS_CONSENT_REQUIRED="true" # BR-5.1 — gates Event collection entirely when true

# --- GitHub sync job (Constitution §3) ---
GITHUB_SYNC_TOKEN="" # read-only PAT scoped to MALULEKE-KS, KSDRILL-SA, GrowthCore-Solutions
GITHUB_SYNC_ORGS="MALULEKE-KS,KSDRILL-SA,GrowthCore-Solutions"

# --- Observability ---
SENTRY_DSN=""
BETTER_STACK_SOURCE_TOKEN=""
PROMETHEUS_PUSHGATEWAY_URL=""

# --- Rate limiting (BR-2.4) ---
INQUIRY_RATE_LIMIT_PER_IP_PER_DAY="5"

# --- Data retention (BR-5.2) ---
DATA_RETENTION_MONTHS="24"

# --- Feature flags default state ---
# Individual flags live in the Flag table (seeded disabled — see seed.ts, BR-4.4).
# This var is a kill switch only, for emergencies — not a substitute for the table.
FEATURE_FLAGS_KILL_SWITCH="false"
