{
  "name": "malulekeks",
  "version": "0.1.0",
  "private": true,
  "description": "MALULEKE-KS — Kurhula Success Maluleke's personal platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run tests/unit --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:e2e": "node scripts/run-e2e-if-present.mjs",
    "test:ai-evals": "vitest run tests/ai-evals --passWithNoTests",
    "test:watch": "vitest",
    "prisma:generate": "dotenv -e .env.development.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.development.local -- prisma migrate dev",
    "prisma:deploy": "dotenv -e .env.development.local -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .env.development.local -- prisma studio",
    "db:seed": "dotenv -e .env.development.local -- tsx prisma/seed.ts",
    "sync:github": "dotenv -e .env.development.local -- tsx scripts/github-sync.ts",
    "create-admin": "dotenv -e .env.development.local -- tsx scripts/create-admin.ts",
    "docs:capabilities": "tsx --tsconfig tsconfig.json scripts/generate-capability-docs.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.126",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "ai": "^7.0.123",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx": "^9.7.1",
    "lucide-react": "^0.469.0",
    "motion": "^13.4.0",
    "next": "^16.3.5",
    "otpauth": "^9.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^2.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "@vercel/config": "^0.7.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.1"
  }
}
